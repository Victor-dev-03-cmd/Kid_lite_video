# Frontend-safe public key (returned from /api/config)
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# Backend-only secret keys (NEVER send to frontend, NEVER commit .env)
CLERK_SECRET_KEY=sk_test_REPLACE_ME
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_ME
# Recommended for server-only Supabase access; required once database routes are active
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
YOUTUBE_API_KEY=REPLACE_ME
